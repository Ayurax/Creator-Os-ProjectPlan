# CreatorOS environment variables
# Copy this file to backend/.env and replace development values.

PORT=3000
NODE_ENV=development

# Local SQLite database used by backend/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Required. Use a long random value in every environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional Groq integration. Leave unset when using mock mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MOCK_AI=true

# Frontend
VITE_API_URL=http://localhost:3000/api

# Production backend (Render)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# NODE_ENV=production
# FRONTEND_URL=https://YOUR-VERCEL-APP.vercel.app
# CORS_ORIGINS=https://YOUR-VERCEL-APP.vercel.app
# MOCK_AI=false
