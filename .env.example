# CreatorOS AI Environment Variables
# Copy this file to .env and fill in the values

# Node.js Backend
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/creatoros?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# AI API Keys (for when not using mock mode)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For development only - enables mock AI mode
MOCK_AI=true

# Frontend
VITE_API_URL=http://localhost:3000/api
