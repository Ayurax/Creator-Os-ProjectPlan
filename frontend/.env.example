# Use /api with the Vite proxy during local development.
# Set the Render HTTPS API origin for deployed environments.
VITE_API_URL=/api
# Optional local proxy target; the backend defaults to port 3000.
BACKEND_URL=http://localhost:3000

# Vercel production example:
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
